<?xml version="1.0"?>
<sdf version="1.8" xmlns:xacro="http://ros.org/wiki/xacro">
    <model name='myrobot' canonical_link='base_link'>

        <!-- === Parameters === -->
        <xacro:property name="base_length" value="0.20" />
        <xacro:property name="base_width" value="0.15" />
        <xacro:property name="base_height" value="0.05" />

        <xacro:property name="wheel_radius" value="0.04" />
        <xacro:property name="wheel_width" value="0.02" />
        <xacro:property name="caster_radius" value="0.02" />
        <xacro:property name="wheel_ygap" value="0.085" />
        <xacro:property name="wheel_zoff" value="0.00" />
        <xacro:property name="wheel_xoff" value="0.05" />

        <xacro:property name="caster_xoff" value="0.08" />

        <xacro:arg name="namespace" default="" />

        <!-- Define some commonly used inertial properties  -->
        <!-- <xacro:macro name="box_inertia" params="m w h d">
